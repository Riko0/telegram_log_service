# Required
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Web server
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=5000

# Optional: Bearer token to protect /api/logs endpoint
# WEB_AUTH_TOKEN=your_secret_token

# Staleness detection (seconds)
STALL_ALERT_THRESHOLD_SECONDS=1800
STALLED_RUN_AUTO_REMOVE_THRESHOLD_SECONDS=3600

# Heartbeat-based staleness (shorter threshold for runs that send heartbeats)
HEARTBEAT_STALL_THRESHOLD_SECONDS=300

# Minimum seconds between best-metric-changed alerts for the same run
BEST_METRIC_ALERT_COOLDOWN_SECONDS=300

# Admin user (Telegram username without @)
ADMIN_TELEGRAM_NAME=your_telegram_username
